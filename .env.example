# Copy to .env and fill in. Never commit .env.
SPECTRUM_PROJECT_ID=     # Spectrum Cloud project (app.photon.codes), spec 008
SPECTRUM_PROJECT_SECRET=
BOT_MODE=auto            # auto (relay to /chat, echo while it doesn't exist) | echo | chat
WINDY_API_KEY=           # Windy Webcams, spec 013 (api.windy.com/keys)
CENSUS_API_KEY=          # api.census.gov/data/key_signup.html (county dashboard)
MAPILLARY_TOKEN=         # quote it: contains | (docs/07)
SYNOPTIC_API_KEY=        # synopticdata.com open access; token via /v2/auth?apikey=
SYNOPTIC_TOKEN=
TOMTOM_API_KEY=          # developer.tomtom.com, traffic incidents (docs/07)
API_BASE=http://localhost:8000
WEB_BASE=                # GitHub Pages URL for /web
AZURE_OPENAI_API_KEY=    # Azure OpenAI (agent 007 + camera check 010)
AZURE_OPENAI_ENDPOINT=   # https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT= # gpt-4.1-mini
TIGER_DATABASE_URL=      # Tiger Cloud (Timescale) Postgres connection string, J11

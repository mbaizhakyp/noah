# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=            # current Gemini Flash model ID, see ai.google.dev/gemini-api/docs/models
# PHOTON_*               # names per Photon Spectrum docs (spec 008)
GA511_API_KEY=           # 511GA developer key, spec 013 (511ga.org/developers/doc)
API_BASE=http://localhost:8000
WEB_BASE=                # GitHub Pages URL for /web
